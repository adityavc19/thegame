      <div style={{ fontSize: 18, color: C.creamMuted, marginBottom: 36, opacity: p >= 1 ? 1 : 0, transition: "opacity 0.8s" }}>32 months pass...</div>
      <div style={{ width: "100%", display: "flex", flexDirection: "column", gap: 10 }}>
        {s.map((x, i) => <div key={i} style={{ background: C.bgCard, borderLeft: `3px solid ${x.c}`, borderRadius: "0 8px 8px 0", padding: "12px 16px", opacity: p >= i + 2 ? 1 : 0, transform: p >= i + 2 ? "translateX(0)" : "translateX(-16px)", transition: "all 0.5s ease" }}><div style={{ fontSize: 9, fontFamily: "var(--sans)", letterSpacing: "0.15em", color: C.creamDim, textTransform: "uppercase", marginBottom: 4 }}>{x.l}</div><div style={{ display: "flex", alignItems: "center", gap: 8 }}><span style={{ fontSize: 15, color: C.creamDim, fontFamily: "var(--sans)" }}>{x.f}</span><span style={{ fontSize: 11, color: C.creamDim }}>→</span><span style={{ fontSize: 17, fontWeight: 700, color: x.c, fontFamily: "var(--sans)" }}>{x.t}</span></div></div>)}
      </div>
      {p >= 4 && <button onClick={onContinue} style={{ width: "100%", marginTop: 28, padding: "16px", background: C.coral, color: C.bg, border: "none", borderRadius: 8, fontSize: 13, fontFamily: "var(--sans)", fontWeight: 700, letterSpacing: "0.1em", textTransform: "uppercase", cursor: "pointer", animation: "fadeUp 0.5s ease" }}>Next Decision →</button>}
    </div>
  );
}

