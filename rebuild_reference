        {m.type === "timeline" && <div style={{ position: "relative", paddingLeft: 20 }}><div style={{ position: "absolute", left: 4, top: 8, bottom: 8, width: 1, background: C.border }} />{m.events.map((e, i) => <div key={i} style={{ position: "relative", paddingBottom: i < m.events.length - 1 ? 18 : 0, animation: `fadeIn 0.4s ease ${i * 0.15}s both` }}><div style={{ position: "absolute", left: -20, top: 6, width: 9, height: 9, borderRadius: "50%", background: e.mood === "warning" ? C.gold : e.mood === "positive" ? C.green : C.creamDim, border: `2px solid ${C.bg}` }} /><div style={{ fontSize: 10, fontFamily: "var(--sans)", fontWeight: 700, color: C.creamDim, letterSpacing: "0.1em", marginBottom: 3 }}>{e.date}</div><div style={{ fontSize: 13, lineHeight: 1.6, color: e.mood === "warning" ? C.cream : C.creamMuted, fontWeight: e.mood === "warning" ? 600 : 400 }}>{e.text}</div></div>)}</div>}
