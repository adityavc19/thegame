// ============================================
// SCENE BEAT
// ============================================
function SceneBeat({ onContinue }) {
  const [v, setV] = useState(0);
  const lines = [
    { t: "date", text: "JAN 2007" },
    { t: "title", text: "The iPhone Moment" },
    { t: "image" },
    { t: "p", text: `Your phone buzzes at 5:58 AM Pacific. It's Kevin Turner, your COO. "Steve, you watching Macworld?"` },
    { t: "p", text: `You switch on CNBC. Jobs is on stage in his black turtleneck, holding something. "This is a day I've been looking forward to for two and a half years."` },
    { t: "p", text: `Three products. An iPod. A phone. An internet communicator. The crowd doesn't get it yet — then they do.` },
    { t: "p", text: `By 7 AM, your inbox has 43 messages. The consensus from your mobile team: "No physical keyboard. Enterprise won't touch it. It's an iPod that makes calls."` },
    { t: "em", text: `But you've seen this movie before. Everyone laughed at the iPod too. And you've just watched 4,000 people give Steve Jobs a standing ovation for a phone that doesn't exist yet.` },
    { t: "p", text: `Windows Mobile owns 42% of the smartphone market. You've got partnerships with every carrier, every major OEM. Your enterprise relationships are unassailable.` },
    { t: "close", text: `The question isn't whether the iPhone is a threat. The question is what kind of threat — and what you're going to do about it.` },
  ];
  useEffect(() => { if (v < lines.length) { const d = v === 0 ? 400 : v === 2 ? 600 : 120; const t = setTimeout(() => setV(n => n + 1), d); return () => clearTimeout(t); } }, [v, lines.length]);

  return (
    <div style={{ padding: "0 24px 80px" }}>
      {lines.map((l, i) => {
        if (i > v) return null;
        const a = { opacity: 1, transform: "translateY(0)", transition: "all 0.6s ease" };
        if (l.t === "date") return <div key={i} style={{ ...a, fontSize: 13, fontFamily: "var(--sans)", letterSpacing: "0.2em", color: C.coral, textTransform: "uppercase", marginBottom: 8, marginTop: 16 }}>{l.text}</div>;
        if (l.t === "title") return <h1 key={i} style={{ ...a, fontSize: 30, fontWeight: 700, color: C.coral, marginBottom: 20, lineHeight: 1.15 }}>{l.text}</h1>;
        if (l.t === "image") return <div key={i} style={{ ...a, width: "100%", height: 170, borderRadius: 8, background: "linear-gradient(135deg, #1a1a2e, #16213e, #0f3460)", marginBottom: 24, display: "flex", alignItems: "center", justifyContent: "center", position: "relative" }}><div style={{ position: "absolute", inset: 0, background: "radial-gradient(circle at 70% 40%, rgba(100,140,255,0.12), transparent 60%)" }} /><span style={{ fontSize: 10, fontFamily: "var(--sans)", color: C.creamDim, letterSpacing: "0.15em", textTransform: "uppercase" }}>[ Macworld 2007 ]</span></div>;
        if (l.t === "em") return <p key={i} style={{ ...a, fontSize: 16, lineHeight: 1.75, color: C.cream, marginBottom: 20, fontStyle: "italic", borderLeft: `2px solid ${C.coral}`, paddingLeft: 16 }}>{l.text}</p>;
        if (l.t === "close") return <p key={i} style={{ ...a, fontSize: 17, lineHeight: 1.7, color: C.cream, marginBottom: 28, fontWeight: 600 }}>{l.text}</p>;
        return <p key={i} style={{ ...a, fontSize: 16, lineHeight: 1.75, color: C.cream, marginBottom: 20 }}>{l.text}</p>;
      })}
      {v >= lines.length && <button onClick={onContinue} style={{ width: "100%", padding: "16px", background: C.coral, color: C.bg, border: "none", borderRadius: 8, fontSize: 13, fontFamily: "var(--sans)", fontWeight: 700, letterSpacing: "0.1em", textTransform: "uppercase", cursor: "pointer", animation: "fadeUp 0.5s ease" }}>Review Intel & Decide →</button>}
    </div>
  );
}

