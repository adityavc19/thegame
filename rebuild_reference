// ============================================
// POPUP: ENTITY CARD (with flip)
// ============================================
function EntityPopup({ data, onClose }) {
  const [flipped, setFlipped] = useState(false);
  const [show, setShow] = useState(false);
  useEffect(() => { requestAnimationFrame(() => setShow(true)); }, []);
  const close = () => { setShow(false); setTimeout(onClose, 250); };

  const sentColors = { dangerous: C.red, unproven: C.gold, dismissive: C.creamDim, panicking: C.gold };
  const d = data.popup;

  return (
    <Overlay show={show} onClose={close}>
      <div style={{ perspective: 1000, width: "100%", maxWidth: 310 }}>
        <div style={{ transformStyle: "preserve-3d", transform: flipped ? "rotateY(180deg)" : "rotateY(0)", transition: "transform 0.5s cubic-bezier(0.4,0,0.2,1)" }}>

          {/* FRONT */}
          <div style={{ backfaceVisibility: "hidden", WebkitBackfaceVisibility: "hidden", borderRadius: 14, overflow: "hidden", border: `1px solid ${C.borderLight}`, background: C.bgCard }}>
            <div style={{ height: 160, background: d.gradient, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", position: "relative" }}>
              <DotPattern />
              <span style={{ fontSize: 44, position: "relative", zIndex: 1 }}>{d.icon}</span>
              <span style={{ fontSize: 10, fontFamily: "var(--sans)", letterSpacing: "0.2em", color: "rgba(255,255,255,0.4)", textTransform: "uppercase", marginTop: 6, position: "relative", zIndex: 1 }}>{d.category}</span>
            </div>
            <div style={{ padding: "16px 18px 14px" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
                <div>
                  <div style={{ fontSize: 17, fontWeight: 700, color: C.cream, fontFamily: "var(--sans)" }}>{d.name}</div>
                  <div style={{ fontSize: 11, color: C.creamMuted, fontFamily: "var(--sans)", marginTop: 2 }}>{d.front.shortStat}</div>
                </div>
                <SentimentBadge text={d.front.sentiment} color={sentColors[d.front.sentimentKey] || C.creamDim} />
              </div>
              <StatsGrid items={d.front.quickStats} />
              <button onClick={() => setFlipped(true)} style={{ ...flipBtnStyle, marginTop: 14 }}>↻ Flip for intel briefing</button>
            </div>
            <SourceBar source={d.front.source} reliability={d.front.reliability} />
          </div>

          {/* BACK */}
          <div style={{ position: "absolute", top: 0, left: 0, width: "100%", backfaceVisibility: "hidden", WebkitBackfaceVisibility: "hidden", transform: "rotateY(180deg)", borderRadius: 14, overflow: "hidden", border: `1px solid ${C.borderLight}`, background: C.bgCard }}>
            <div style={{ padding: "14px 18px", borderBottom: `1px solid ${C.border}`, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                <span style={{ fontSize: 18 }}>{d.icon}</span>
                <span style={{ fontSize: 13, fontWeight: 700, color: C.cream, fontFamily: "var(--sans)" }}>{d.name}</span>
              </div>
              <TypeBadge text="Intel Brief" color={C.entityAccent} />
            </div>
            <div style={{ padding: "14px 18px", borderBottom: `1px solid ${C.border}` }}>
              <SectionLabel text="Key Signal" color={C.entityAccent} />
              <p style={{ fontSize: 14, lineHeight: 1.65, color: C.cream, margin: 0, fontStyle: "italic" }}>"{d.back.keySignal}"</p>
            </div>
            <div style={{ padding: "6px 18px" }}>
              {d.back.details.map((r, i) => <DetailRow key={i} label={r.label} value={r.value} color={r.color} last={i === d.back.details.length - 1} />)}
            </div>
            {d.back.analysisNote && (
              <div style={{ margin: "0 18px 14px", padding: "10px 12px", background: `${C.entityAccent}08`, borderRadius: 6, borderLeft: `2px solid ${C.entityAccent}33` }}>
                <div style={{ fontSize: 9, fontFamily: "var(--sans)", color: C.entityAccent, letterSpacing: "0.1em", textTransform: "uppercase", marginBottom: 3 }}>Analysis</div>
                <p style={{ fontSize: 11, lineHeight: 1.5, color: C.creamMuted, margin: 0, fontFamily: "var(--sans)" }}>{d.back.analysisNote}</p>
              </div>
            )}
            <div style={{ padding: "0 18px 14px" }}>
              <button onClick={() => setFlipped(false)} style={flipBtnStyle}>↻ Flip back</button>
            </div>
          </div>
        </div>
      </div>
    </Overlay>
  );
}

