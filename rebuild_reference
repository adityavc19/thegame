// ============================================
// SHARED COMPONENTS
// ============================================
function Overlay({ show, onClose, children }) {
  return (
    <div onClick={onClose} style={{
      position: "fixed", inset: 0, zIndex: 200,
      background: show ? C.bgOverlay : "transparent",
      backdropFilter: show ? "blur(10px)" : "none", WebkitBackdropFilter: show ? "blur(10px)" : "none",
      display: "flex", alignItems: "center", justifyContent: "center",
      transition: "all 0.25s ease", padding: 20,
    }}>
      <div onClick={e => e.stopPropagation()} style={{
        opacity: show ? 1 : 0, transform: show ? "scale(1) translateY(0)" : "scale(0.92) translateY(16px)",
        transition: "all 0.3s cubic-bezier(0.34,1.56,0.64,1)", position: "relative",
        width: "100%", display: "flex", justifyContent: "center",
      }}>
        {children}
        <button onClick={onClose} style={{
          position: "absolute", top: -10, right: -2, width: 30, height: 30, borderRadius: "50%",
          background: C.bgCard, border: `1px solid ${C.borderLight}`, color: C.creamMuted,
          fontSize: 15, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", zIndex: 10,
        }}>×</button>
      </div>
    </div>
  );
}

function DotPattern() {
  return <div style={{ position: "absolute", inset: 0, opacity: 0.05, backgroundImage: `radial-gradient(${C.cream} 1px, transparent 1px)`, backgroundSize: "18px 18px" }} />;
}

function SentimentBadge({ text, color }) {
  return <div style={{ fontSize: 8, fontFamily: "var(--sans)", fontWeight: 700, color, letterSpacing: "0.1em", textTransform: "uppercase", textAlign: "right", lineHeight: 1.4, padding: "3px 7px", background: `${color}12`, borderRadius: 4, whiteSpace: "pre-line" }}>{text}</div>;
}

function TypeBadge({ text, color }) {
  return <div style={{ display: "inline-block", fontSize: 9, fontFamily: "var(--sans)", fontWeight: 700, letterSpacing: "0.15em", color, textTransform: "uppercase", padding: "3px 10px", border: `1px solid ${color}33`, borderRadius: 4 }}>{text}</div>;
}

function SectionLabel({ text, color }) {
  return <div style={{ fontSize: 9, fontFamily: "var(--sans)", letterSpacing: "0.15em", color, textTransform: "uppercase", marginBottom: 6, display: "flex", alignItems: "center", gap: 6 }}>
    <span style={{ display: "inline-block", width: 12, height: 1, background: color }} />{text}
  </div>;
}

function StatsGrid({ items }) {
  return <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "1px", background: C.border, borderRadius: 8, overflow: "hidden" }}>
    {items.map((s, i) => (
      <div key={i} style={{ background: C.bgCard, padding: "9px 10px" }}>
        <div style={{ fontSize: 9, fontFamily: "var(--sans)", color: C.creamDim, letterSpacing: "0.08em", textTransform: "uppercase", marginBottom: 2 }}>{s.label}</div>
        <div style={{ fontSize: 13, fontFamily: "var(--sans)", fontWeight: 600, color: s.color || C.cream }}>{s.value}</div>
      </div>
    ))}
  </div>;
}

function DetailRow({ label, value, color, last }) {
  return <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "8px 0", borderBottom: !last ? `1px solid ${C.border}` : "none" }}>
    <span style={{ fontSize: 11, fontFamily: "var(--sans)", color: C.creamMuted }}>{label}</span>
    <span style={{ fontSize: 11, fontFamily: "var(--sans)", fontWeight: 600, color: color || C.cream }}>{value}</span>
  </div>;
}

function SourceBar({ source, reliability }) {
  return <div style={{ padding: "8px 18px", borderTop: `1px solid ${C.border}`, display: "flex", justifyContent: "space-between", fontSize: 9, fontFamily: "var(--sans)", color: C.creamDim, letterSpacing: "0.1em", textTransform: "uppercase" }}>
    <span>{source}</span>
    <span style={{ color: reliability === "HIGH" ? C.green : C.gold, fontWeight: 600 }}>{reliability}</span>
  </div>;
}

const flipBtnStyle = { width: "100%", padding: "9px", background: "transparent", border: `1px solid ${C.border}`, borderRadius: 6, cursor: "pointer", fontSize: 11, fontFamily: "var(--sans)", color: C.creamMuted, letterSpacing: "0.05em", display: "flex", alignItems: "center", justifyContent: "center", gap: 6 };

// ============================================
// CARD THUMBNAILS (type-aware)
// ============================================
function CardThumb({ card, onClick }) {
  const t = card.thumb;
  const isEntity = card.type === "entity";
  const isMemo = card.type === "memo";
  const isBriefing = card.type === "briefing";

  const headerBg = isEntity
    ? (card.popup.gradient || `linear-gradient(135deg, #1a1a25 0%, #252030 100%)`)
    : isMemo
      ? `linear-gradient(135deg, #1f1a14 0%, #2a2118 100%)`
      : `linear-gradient(135deg, #121f1a 0%, #1a2a22 100%)`;

  return (
    <div onClick={onClick} style={{
      background: C.bgCard, border: `1px solid ${C.border}`, borderRadius: 10,
      overflow: "hidden", cursor: "pointer", transition: "all 0.2s ease",
      flex: card.secondary ? "1 1 100%" : "1 1 calc(50% - 5px)",
      minWidth: card.secondary ? "100%" : "calc(50% - 5px)",
    }}>
      {/* Header strip */}
      <div style={{ height: card.secondary ? 36 : 44, background: headerBg, display: "flex", alignItems: "center", justifyContent: "center", position: "relative" }}>
        {isEntity && <DotPattern />}
        <span style={{ fontSize: card.secondary ? 16 : 20, position: "relative", zIndex: 1 }}>{t.icon}</span>
      </div>
      <div style={{ padding: card.secondary ? "8px 12px" : "10px 12px" }}>
        {/* Type label */}
        <div style={{
          fontSize: 8, fontFamily: "var(--sans)", fontWeight: 700, letterSpacing: "0.12em", textTransform: "uppercase",
          color: isMemo ? C.memoAccent : isBriefing ? C.briefingAccent : C.entityAccent,
          marginBottom: 3,
        }}>{t.label}</div>
        <div style={{ fontSize: 12, fontWeight: 700, color: C.cream, fontFamily: "var(--sans)", marginBottom: 2 }}>{t.title}</div>
        <div style={{ fontSize: 10, color: C.creamMuted, fontFamily: "var(--sans)", lineHeight: 1.3 }}>{t.subtitle}</div>
        {/* Sentiment for entities */}
        {isEntity && t.sentiment && (
          <div style={{ marginTop: 5, fontSize: 8, fontFamily: "var(--sans)", fontWeight: 700, color: t.sentimentColor, letterSpacing: "0.1em", textTransform: "uppercase", lineHeight: 1.3 }}>{t.sentiment}</div>
        )}
      </div>
    </div>
  );
}

// ============================================
// POPUP ROUTER
// ============================================
function CardPopupRouter({ card, onClose }) {
  if (!card) return null;
  if (card.type === "entity") return <EntityPopup data={card} onClose={onClose} />;
  if (card.type === "memo") return <MemoPopup data={card} onClose={onClose} />;
  if (card.type === "briefing") return <BriefingPopup data={card} onClose={onClose} />;
  return null;
}

