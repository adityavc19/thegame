// ============================================
// CONSEQUENCE BEAT
// ============================================
function ConsequenceBeat({ onContinue }) {
  const [step, setStep] = useState(0);
  const [entered, setEntered] = useState(false);
  useEffect(() => { setTimeout(() => setEntered(true), 100); }, []);

  const moments = [
    { type: "verdict", label: "The Street Reacts", headline: "Wall Street approves of your discipline.", subline: "\"Ballmer wisely avoiding panic,\" writes Goldman Sachs." },
    { type: "metrics", label: "Metrics Impact", changes: [
      { metric: "Market Cap", change: "+$1B", dir: "up" }, { metric: "Stock Price", change: "+2.3%", dir: "up" },
      { metric: "Board Mood", change: "Approving", dir: "up" }, { metric: "Mobile Team", change: "Complacent", dir: "neutral" },
    ]},
    { type: "timeline", label: "First Ripple Effects", events: [
      { date: "JUN 29", text: "iPhone launches. Lines around the block. Breathless media coverage.", mood: "neutral" },
      { date: "JULY", text: "Early reviews: poor battery, AT&T struggling, no App Store. Your team: \"Told you so.\"", mood: "positive" },
      { date: "AUG", text: "Windows Mobile 6.1 on schedule. Enterprise satisfied. Board commends patience.", mood: "positive" },
      { date: "OCT", text: "Apple announces App Store is coming. They just created a platform, not just a phone.", mood: "warning" },
    ]},
    { type: "emerging", label: "Emerging Threat", headline: "Then Google drops the real bomb.", body: "Android with the Open Handset Alliance: HTC, Samsung, LG, Motorola — all your hardware partners. Android will be free and open source. The OEMs don't have to pay you licensing fees anymore.", closing: "The market just forked and you're standing at the intersection holding a map from 2005." },
  ];

  const advance = () => { step < moments.length - 1 ? setStep(s => s + 1) : onContinue(); };
  const m = moments[step];

  return (
    <div style={{ padding: "0 20px 100px", opacity: entered ? 1 : 0, transition: "opacity 0.5s ease" }}>
      <div style={{ padding: "10px 14px", background: `${C.coral}10`, borderLeft: `2px solid ${C.coral}`, borderRadius: "0 6px 6px 0", marginBottom: 28, fontSize: 13, fontFamily: "var(--sans)", color: C.creamMuted }}>
        You chose: <strong style={{ color: C.coral }}>Wait and Watch</strong>
      </div>
      <div style={{ display: "flex", justifyContent: "center", gap: 8, marginBottom: 24 }}>
        {moments.map((_, i) => <div key={i} style={{ width: i === step ? 24 : 6, height: 6, borderRadius: 3, background: i <= step ? C.coral : C.border, transition: "all 0.4s ease" }} />)}
