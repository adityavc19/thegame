<script>
  const screen = document.getElementById('screen');
  const networkLayer = document.getElementById('networkLayer');
  const cards = screen.querySelectorAll('.metric-card');
  const scrambles = screen.querySelectorAll('.value-scramble');

  const scrambleChars = '0123456789%$BM.+-';
  let scrambleIntervals = [];

  function getMetricEls() {
    return screen.querySelectorAll('.status-label, .metric-card');
  }

  function getNetworkEls() {
    return screen.querySelectorAll(
      '.net-line, .net-branch, .net-node, .net-node-t, ' +
      '.net-sig, .net-sig-fill, .net-sig-ink, .net-glyph, .ghost-icon'
    );
  }

  function startScramble() {
    scrambles.forEach((el) => {
      const final = el.dataset.final;
      const interval = setInterval(() => {
        let s = '';
        for (let j = 0; j < final.length; j++) {
          s += scrambleChars[Math.floor(Math.random() * scrambleChars.length)];
        }
        el.textContent = s;
      }, 55);
      scrambleIntervals.push(interval);
    });
  }

  function stopScramble() {
    scrambleIntervals.forEach(i => clearInterval(i));
    scrambleIntervals = [];
    scrambles.forEach(el => el.textContent = el.dataset.final);
  }

  function reset() {
    screen.classList.remove('exiting');
    networkLayer.classList.remove('breathing', 'fading');
    networkLayer.style.opacity = '';
    cards.forEach(c => c.classList.remove('revealing', 'show-after'));
    getMetricEls().forEach(el => el.classList.remove('active'));
    getNetworkEls().forEach(el => el.classList.remove('active'));
    screen.querySelectorAll('.scan-line').forEach(el => el.classList.remove('active'));
    stopScramble();
    scrambles.forEach(el => { el.textContent = '?'; el.style.opacity = ''; el.style.transform = ''; });
    screen.querySelectorAll('.value-resolved').forEach(el => { el.style.opacity = '0'; el.style.transform = 'translateY(8px)'; });
    screen.querySelectorAll('.value-delta').forEach(el => { el.style.opacity = '0'; });
    screen.querySelectorAll('.value-current').forEach(el => { el.style.opacity = '0'; });
    screen.querySelectorAll('.value-arrow').forEach(el => { el.style.opacity = '0'; });
  }

  function play() {
    reset();
    void screen.offsetHeight;

    // ── PHASE 1 (0s): Metrics appear — labels + before values only ──
    requestAnimationFrame(() => {
      getMetricEls().forEach(el => el.classList.add('active'));
    });

    // ── PHASE 2 (0.15s): Background network starts drawing in ──
    setTimeout(() => {
      getNetworkEls().forEach(el => el.classList.add('active'));
      screen.querySelector('.scan-line').classList.add('active');
    }, 150);

    // ── PHASE 3 (0.4s): Arrow + scramble ? appear on metrics ──
    setTimeout(() => {
      cards.forEach(c => c.classList.add('show-after'));
    }, 400);

    // ── PHASE 4 (0.55s): Network starts breathing, scramble begins ──
    setTimeout(() => {
      networkLayer.classList.add('breathing');
      startScramble();
    }, 550);

    // ── PHASE 5 (0.85s): Network starts slow fadeout ──
    setTimeout(() => {
      networkLayer.classList.remove('breathing');
      networkLayer.classList.add('fading');
    }, 850);

    // ── PHASE 6 (1.05s): Values resolve ──
    setTimeout(() => {
      stopScramble();
      cards.forEach(c => c.classList.add('revealing'));
    }, 1050);

    // ── PHASE 7 (1.75s): Metrics exit ──
    setTimeout(() => {
      screen.classList.add('exiting');
    }, 1750);
  }

  setTimeout(play, 300);
  document.getElementById('replayBtn').addEventListener('click', play);
</script>
