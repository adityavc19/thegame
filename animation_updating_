<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Metrics Update v4</title>
<style>
  :root {
    --bg: #F5F2EE;
    --ink: #1A1718;
    --ink-mid: rgba(26, 23, 24, 0.4);
    --ink-dim: rgba(26, 23, 24, 0.12);
    --ink-ghost: rgba(26, 23, 24, 0.06);
    --coral: #E8856C;
    --coral-mid: rgba(232, 133, 108, 0.5);
    --coral-dim: rgba(232, 133, 108, 0.15);
    --coral-glow: rgba(232, 133, 108, 0.3);
    --line: rgba(26, 23, 24, 0.1);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
  }

  .screen {
    position: relative;
    width: 390px;
    height: 700px;
    overflow: hidden;
  }

  /* ═══ PROPAGATION NETWORK BACKGROUND ═══ */
  .network-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* network lines */
  .net-line {
    stroke: var(--ink-mid);
    stroke-width: 1;
    fill: none;
    opacity: 0;
  }
  .net-line.active {
    animation: netLineIn 0.6s ease-out forwards;
  }
  @keyframes netLineIn {
    0%   { opacity: 0; stroke-dashoffset: 300; }
    40%  { stroke: var(--ink-mid); }
    100% { opacity: 0.25; stroke-dashoffset: 0; }
  }

  .net-line { stroke-dasharray: 300; stroke-dashoffset: 300; }

  .nl-1  { animation-delay: 0.02s !important; }
  .nl-2  { animation-delay: 0.06s !important; }
  .nl-3  { animation-delay: 0.04s !important; }
  .nl-4  { animation-delay: 0.08s !important; }
  .nl-5  { animation-delay: 0.05s !important; }
  .nl-6  { animation-delay: 0.10s !important; }

  /* secondary branches */
  .net-branch {
    stroke: var(--ink-dim);
    stroke-width: 0.7;
    fill: none;
    stroke-dasharray: 150;
    stroke-dashoffset: 150;
    opacity: 0;
  }
  .net-branch.active {
    animation: branchIn 0.45s ease-out forwards;
  }
  @keyframes branchIn {
    0%   { opacity: 0; stroke-dashoffset: 150; }
    100% { opacity: 0.18; stroke-dashoffset: 0; }
  }

  .nb-1  { animation-delay: 0.20s !important; }
  .nb-2  { animation-delay: 0.24s !important; }
  .nb-3  { animation-delay: 0.22s !important; }
  .nb-4  { animation-delay: 0.26s !important; }
  .nb-5  { animation-delay: 0.23s !important; }
  .nb-6  { animation-delay: 0.28s !important; }
  .nb-7  { animation-delay: 0.25s !important; }
  .nb-8  { animation-delay: 0.30s !important; }
  .nb-9  { animation-delay: 0.27s !important; }
  .nb-10 { animation-delay: 0.32s !important; }
  .nb-11 { animation-delay: 0.29s !important; }
  .nb-12 { animation-delay: 0.34s !important; }

  /* network nodes */
  .net-node {
    fill: var(--ink);
    opacity: 0;
  }
  .net-node.active {
    animation: netNodeIn 0.4s ease-out forwards;
  }
  @keyframes netNodeIn {
    0%   { opacity: 0; }
    50%  { opacity: 0.45; }
    100% { opacity: 0.25; }
  }

  .nn-1  { animation-delay: 0.12s !important; }
  .nn-2  { animation-delay: 0.16s !important; }
  .nn-3  { animation-delay: 0.14s !important; }
  .nn-4  { animation-delay: 0.18s !important; }
  .nn-5  { animation-delay: 0.15s !important; }
  .nn-6  { animation-delay: 0.20s !important; }

  /* tertiary nodes */
  .net-node-t {
    fill: var(--ink);
    opacity: 0;
  }
  .net-node-t.active {
    animation: netNodeTIn 0.3s ease-out forwards;
  }
  @keyframes netNodeTIn {
    0% { opacity: 0; } 50% { opacity: 0.3; } 100% { opacity: 0.15; }
  }
  .nnt-1  { animation-delay: 0.30s !important; }
  .nnt-2  { animation-delay: 0.33s !important; }
  .nnt-3  { animation-delay: 0.31s !important; }
  .nnt-4  { animation-delay: 0.35s !important; }
  .nnt-5  { animation-delay: 0.32s !important; }
  .nnt-6  { animation-delay: 0.36s !important; }
  .nnt-7  { animation-delay: 0.34s !important; }
  .nnt-8  { animation-delay: 0.37s !important; }

  /* signal fragments on network */
  .net-sig {
    fill: none;
    stroke: var(--coral);
    stroke-width: 1.2;
    opacity: 0;
  }
  .net-sig.active {
    animation: netSigIn 0.5s ease-out forwards;
  }
  .net-sig-fill {
    fill: var(--coral);
    stroke: none;
    opacity: 0;
  }
  .net-sig-fill.active {
    animation: netSigIn 0.4s ease-out forwards;
  }
  .net-sig-ink line {
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0;
  }
  .net-sig-ink.active line {
    animation: netSigInkIn 0.35s ease-out forwards;
  }
  .net-glyph {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 8px;
    letter-spacing: 1px;
    opacity: 0;
  }
  .net-glyph.active {
    animation: netSigIn 0.5s ease-out forwards;
  }
  .ng-coral { fill: var(--coral); }
  .ng-ink   { fill: var(--ink); }

  @keyframes netSigIn {
    0% { opacity: 0; } 20% { opacity: 0.7; } 100% { opacity: 0.2; }
  }
  @keyframes netSigInkIn {
    0% { opacity: 0; } 20% { opacity: 0.5; } 100% { opacity: 0.15; }
  }

  .ns-1  { animation-delay: 0.15s !important; }
  .ns-2  { animation-delay: 0.19s !important; }
  .ns-3  { animation-delay: 0.17s !important; }
  .ns-4  { animation-delay: 0.22s !important; }
  .ns-5  { animation-delay: 0.20s !important; }
  .ns-6  { animation-delay: 0.25s !important; }
  .ns-7  { animation-delay: 0.18s !important; }
  .ns-8  { animation-delay: 0.28s !important; }
  .ns-9  { animation-delay: 0.23s !important; }
  .ns-10 { animation-delay: 0.26s !important; }

  /* gentle network pulse — breathes after initial draw */
  .network-layer.breathing .net-line {
    animation: breatheLine 2.5s ease-in-out infinite !important;
  }
  .network-layer.breathing .net-node {
    animation: breatheNode 2.5s ease-in-out infinite !important;
  }
  .network-layer.breathing .net-branch {
    animation: breatheBranch 2.5s ease-in-out infinite !important;
  }
  .network-layer.breathing .net-sig,
  .network-layer.breathing .net-sig-fill {
    animation: breatheSig 2s ease-in-out infinite !important;
  }

  @keyframes breatheLine {
    0%   { opacity: 0.12; }
    50%  { opacity: 0.25; }
    100% { opacity: 0.12; }
  }
  @keyframes breatheNode {
    0%   { opacity: 0.15; }
    50%  { opacity: 0.35; }
    100% { opacity: 0.15; }
  }
  @keyframes breatheBranch {
    0%   { opacity: 0.08; }
    50%  { opacity: 0.18; }
    100% { opacity: 0.08; }
  }
  @keyframes breatheSig {
    0%   { opacity: 0.10; }
    50%  { opacity: 0.25; }
    100% { opacity: 0.10; }
  }

  /* ghost icons */
  .ghost-icon { opacity: 0; }
  .ghost-icon.active {
    animation: ghostIn 0.8s ease-out forwards;
  }
  @keyframes ghostIn {
    0% { opacity: 0; } 20% { opacity: 0.15; } 100% { opacity: 0.10; }
  }
  .gi-1 { animation-delay: 0.10s !important; }
  .gi-2 { animation-delay: 0.16s !important; }
  .gi-3 { animation-delay: 0.13s !important; }

  /* ═══ FLOATING NUMBERS ═══ */
  .float-num {
    position: absolute;
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 13px;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .fn-1  { left: 8%;  top: 15%; animation: floatA 2.4s ease-in-out forwards; }
  .fn-2  { left: 78%; top: 12%; animation: floatB 2.6s ease-in-out forwards; }
  .fn-3  { left: 14%; top: 68%; animation: floatC 2.2s ease-in-out forwards; }
  .fn-4  { left: 72%; top: 72%; animation: floatA 2.5s ease-in-out 0.1s forwards; }
  .fn-5  { left: 42%; top: 18%; animation: floatB 2.3s ease-in-out 0.05s forwards; }
  .fn-6  { left: 60%; top: 85%; animation: floatC 2.4s ease-in-out 0.08s forwards; }
  .fn-7  { left: 5%;  top: 42%; animation: floatA 2.7s ease-in-out 0.02s forwards; }
  .fn-8  { left: 85%; top: 48%; animation: floatB 2.5s ease-in-out 0.06s forwards; }
  .fn-9  { left: 28%; top: 88%; animation: floatC 2.3s ease-in-out 0.12s forwards; }
  .fn-10 { left: 88%; top: 28%; animation: floatA 2.6s ease-in-out 0.04s forwards; }

  @keyframes floatA {
    0%   { opacity: 0; transform: translateY(8px); }
    8%   { opacity: 0.28; }
    50%  { opacity: 0.15; transform: translateY(-14px); }
    85%  { opacity: 0.18; }
    100% { opacity: 0; transform: translateY(-30px); }
  }
  @keyframes floatB {
    0%   { opacity: 0; transform: translateY(6px) translateX(0); }
    8%   { opacity: 0.22; }
    50%  { opacity: 0.12; transform: translateY(-10px) translateX(6px); }
    85%  { opacity: 0.15; }
    100% { opacity: 0; transform: translateY(-26px) translateX(8px); }
  }
  @keyframes floatC {
    0%   { opacity: 0; transform: translateY(10px) translateX(0); }
    8%   { opacity: 0.25; }
    50%  { opacity: 0.14; transform: translateY(-8px) translateX(-5px); }
    85%  { opacity: 0.16; }
    100% { opacity: 0; transform: translateY(-24px) translateX(-4px); }
  }

  /* ═══ DRIFTING SHAPES ═══ */
  .drift-shape {
    position: absolute;
    pointer-events: none;
    z-index: 3;
    opacity: 0;
  }

  .ds-diamond { width: 10px; height: 10px; border: 1.5px solid var(--coral); transform: rotate(45deg); }
  .ds-circle  { width: 6px; height: 6px; border-radius: 50%; background: var(--coral); }
  .ds-plus    { width: 8px; height: 8px; position: relative; }
  .ds-plus::before, .ds-plus::after { content: ''; position: absolute; background: var(--ink); }
  .ds-plus::before { left: 50%; top: 0; width: 1px; height: 100%; transform: translateX(-50%); }
  .ds-plus::after  { top: 50%; left: 0; height: 1px; width: 100%; transform: translateY(-50%); }

  .ds-1 { left: 12%; top: 22%; animation: driftUp 2.8s ease-in-out forwards; }
  .ds-2 { left: 82%; top: 60%; animation: driftUpR 2.5s ease-in-out 0.1s forwards; }
  .ds-3 { left: 50%; top: 6%;  animation: driftDown 2.6s ease-in-out 0.05s forwards; }
  .ds-4 { left: 30%; top: 80%; animation: driftUp 2.4s ease-in-out 0.08s forwards; }
  .ds-5 { left: 90%; top: 18%; animation: driftUpR 2.8s ease-in-out 0.02s forwards; }
  .ds-6 { left: 6%;  top: 55%; animation: driftUp 2.3s ease-in-out 0.12s forwards; }
  .ds-7 { left: 75%; top: 88%; animation: driftUpR 2.6s ease-in-out 0.06s forwards; }
  .ds-8 { left: 18%; top: 82%; animation: driftUp 2.5s ease-in-out 0.04s forwards; }
  .ds-9 { left: 85%; top: 38%; animation: driftUpR 2.7s ease-in-out 0.09s forwards; }

  @keyframes driftUp {
    0% { opacity: 0; transform: translateY(0); }
    6% { opacity: 0.35; }
    40% { opacity: 0.20; }
    80% { opacity: 0.14; transform: translateY(-35px); }
    100% { opacity: 0; transform: translateY(-45px); }
  }
  @keyframes driftUpR {
    0% { opacity: 0; transform: translate(0, 0); }
    6% { opacity: 0.30; }
    40% { opacity: 0.18; }
    80% { opacity: 0.12; transform: translate(10px, -28px); }
    100% { opacity: 0; transform: translate(14px, -38px); }
  }
  @keyframes driftDown {
    0% { opacity: 0; transform: translateY(0); }
    6% { opacity: 0.30; }
    40% { opacity: 0.16; }
    80% { opacity: 0.12; transform: translateY(22px); }
    100% { opacity: 0; transform: translateY(32px); }
  }

  /* ═══ FLICKER BARS ═══ */
  .flicker-bar {
    position: absolute;
    height: 1px;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .fb-1 { left: 5%;  width: 40px; top: 20%; animation: flicker 2.2s ease-in-out forwards; }
  .fb-2 { left: 80%; width: 48px; top: 35%; animation: flicker 2.4s ease-in-out 0.15s forwards; }
  .fb-3 { left: 10%; width: 32px; top: 75%; animation: flicker 2.0s ease-in-out 0.08s forwards; }
  .fb-4 { left: 75%; width: 42px; top: 80%; animation: flicker 2.3s ease-in-out 0.2s forwards; }
  .fb-5 { left: 40%; width: 26px; top: 8%;  animation: flicker 2.5s ease-in-out 0.05s forwards; }

  @keyframes flicker {
    0% { opacity: 0; }
    5% { opacity: 0.18; } 15% { opacity: 0.06; }
    25% { opacity: 0.15; } 35% { opacity: 0.04; }
    50% { opacity: 0.12; } 65% { opacity: 0.06; }
    75% { opacity: 0.14; } 85% { opacity: 0.04; }
    100% { opacity: 0; }
  }

  /* ═══ CONTENT ═══ */
  .content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0 28px;
  }

  .status-label {
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--ink-mid);
    opacity: 0;
    margin-bottom: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .status-label.active { animation: labelIn 0.2s ease-out 0.05s forwards; }
  @keyframes labelIn { 0% { opacity: 0; } 100% { opacity: 1; } }

  .pulse-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    border: 1px solid var(--coral);
    position: relative;
  }
  .pulse-dot::after {
    content: '';
    position: absolute; inset: 1px;
    border-radius: 50%;
    background: var(--coral);
    animation: dotPulse 0.5s ease-in-out infinite alternate;
  }
  @keyframes dotPulse { 0% { opacity: 0.2; } 100% { opacity: 1; } }

  /* ─── METRIC CARD — ALIGNED GRID ─── */
  .metric-card {
    width: 100%;
    padding: 20px 0;
    border-bottom: 1px solid var(--ink-ghost);
    opacity: 0;
  }
  .metric-card:first-of-type {
    border-top: 1px solid var(--ink-ghost);
  }
  .metric-card.active { animation: cardIn 0.2s ease-out forwards; }

  .mc-1.active { animation-delay: 0.0s; }
  .mc-2.active { animation-delay: 0.06s; }
  .mc-3.active { animation-delay: 0.12s; }

  @keyframes cardIn { 0% { opacity: 0; } 100% { opacity: 1; } }

  .metric-label {
    font-size: 11px;
    color: var(--ink-mid);
    letter-spacing: 0.5px;
    font-weight: 400;
    margin-bottom: 10px;
    text-align: center;
  }

  /* value row — 3 columns only, centered */
  .value-row {
    display: grid;
    grid-template-columns: 90px 44px 90px;
    align-items: center;
    gap: 24px;
    justify-content: center;
  }

  .value-current {
    font-size: 28px;
    font-weight: 300;
    color: var(--ink);
    letter-spacing: -0.5px;
    text-align: right;
    opacity: 0;
    font-variant-numeric: tabular-nums;
    line-height: 34px;
  }

  /* before values appear immediately with cards */
  .metric-card.active .value-current {
    animation: beforeIn 0.25s ease-out forwards;
  }
  .mc-1.active .value-current { animation-delay: 0.05s; }
  .mc-2.active .value-current { animation-delay: 0.11s; }
  .mc-3.active .value-current { animation-delay: 0.17s; }

  @keyframes beforeIn {
    0%   { opacity: 0; transform: translateY(4px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* arrow — bold directional indicator */
  .value-arrow {
    font-size: 22px;
    font-weight: 800;
    text-align: center;
    opacity: 0;
    line-height: 34px;
  }
  .value-arrow.arrow-up   { color: #5A8A6A; }
  .value-arrow.arrow-down { color: #C25B4A; }

  .value-next-wrap {
    position: relative;
    height: 34px;
    overflow: visible;
    display: flex;
    align-items: center;
  }

  .value-scramble {
    position: absolute;
    left: 0;
    font-size: 28px;
    font-weight: 500;
    color: var(--coral);
    letter-spacing: -0.5px;
    opacity: 0;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .value-resolved {
    position: absolute;
    left: 0;
    font-size: 28px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.5px;
    opacity: 0;
    transform: translateY(8px);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  /* phase 2: arrow and scramble appear */
  .metric-card.show-after .value-arrow {
    animation: afterPartIn 0.2s ease-out forwards;
  }
  .metric-card.show-after .value-scramble {
    animation: afterPartIn 0.2s ease-out forwards;
  }

  .mc-1.show-after .value-arrow    { animation-delay: 0.0s; }
  .mc-1.show-after .value-scramble { animation-delay: 0.05s; }
  .mc-2.show-after .value-arrow    { animation-delay: 0.08s; }
  .mc-2.show-after .value-scramble { animation-delay: 0.13s; }
  .mc-3.show-after .value-arrow    { animation-delay: 0.16s; }
  .mc-3.show-after .value-scramble { animation-delay: 0.21s; }

  @keyframes afterPartIn {
    0%   { opacity: 0; }
    100% { opacity: 0.7; }
  }

  /* phase 3: reveal resolved values */
  .metric-card.revealing .value-scramble {
    animation: scrambleOut 0.15s ease-in forwards !important;
  }
  .metric-card.revealing .value-resolved {
    animation: resolveIn 0.25s ease-out forwards !important;
  }

  .mc-1.revealing .value-scramble { animation-delay: 0.00s !important; }
  .mc-1.revealing .value-resolved { animation-delay: 0.10s !important; }
  .mc-2.revealing .value-scramble { animation-delay: 0.10s !important; }
  .mc-2.revealing .value-resolved { animation-delay: 0.20s !important; }
  .mc-3.revealing .value-scramble { animation-delay: 0.20s !important; }
  .mc-3.revealing .value-resolved { animation-delay: 0.30s !important; }

  @keyframes scrambleOut {
    0% { opacity: 0.7; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-10px); }
  }
  @keyframes resolveIn {
    0% { opacity: 0; transform: translateY(8px); }
    60% { opacity: 1; transform: translateY(-2px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .value-delta {
    position: absolute;
    left: 0;
    top: -15px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    opacity: 0;
    white-space: nowrap;
    line-height: 1;
  }
  .delta-up   { color: #5A8A6A; }
  .delta-down { color: #C25B4A; }

  .metric-card.revealing .value-delta {
    animation: deltaIn 0.2s ease-out forwards;
  }
  .mc-1.revealing .value-delta { animation-delay: 0.20s !important; }
  .mc-2.revealing .value-delta { animation-delay: 0.30s !important; }
  .mc-3.revealing .value-delta { animation-delay: 0.40s !important; }

  @keyframes deltaIn {
    0% { opacity: 0; transform: translateY(4px); }
    60% { opacity: 0.7; }
    100% { opacity: 0.6; transform: translateY(0); }
  }

  /* ─── SCAN LINE ─── */
  .scan-line {
    position: absolute;
    left: 28px; right: 28px;
    height: 1px;
    background: var(--coral);
    opacity: 0;
    top: 50%;
    transform-origin: left;
    transform: scaleX(0);
    z-index: 8;
  }
  .scan-line.active {
    animation: scanSweep 0.35s ease-out 0.02s forwards;
  }
  @keyframes scanSweep {
    0% { opacity: 0; transform: scaleX(0); }
    20% { opacity: 0.35; }
    60% { opacity: 0.12; transform: scaleX(1); }
    100% { opacity: 0; transform: scaleX(1); }
  }

  /* ─── NETWORK SLOW FADEOUT ─── */
  .network-layer.fading {
    transition: opacity 0.8s ease-in;
    opacity: 0 !important;
  }

  /* ─── EXIT (metrics only, at the very end) ─── */
  .screen.exiting .metric-card,
  .screen.exiting .status-label {
    animation: exitUp 0.3s ease-in forwards !important;
  }
  .screen.exiting .mc-1 { animation-delay: 0.00s !important; }
  .screen.exiting .mc-2 { animation-delay: 0.05s !important; }
  .screen.exiting .mc-3 { animation-delay: 0.10s !important; }
  .screen.exiting .status-label { animation-delay: 0.00s !important; }

  @keyframes exitUp {
    0% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-8px); }
  }

  .replay-btn {
    position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%);
    background: none; border: 1px solid var(--ink-dim);
    color: var(--ink-mid); font-family: inherit;
    font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    padding: 10px 28px; cursor: pointer; transition: border-color 0.2s; z-index: 100;
  }
  .replay-btn:hover { border-color: var(--coral); color: var(--coral); }
</style>
</head>
<body>

<div class="screen" id="screen">

  <!-- ═══ PROPAGATION NETWORK (edges + corners, center clear) ═══ -->
  <svg class="network-layer" id="networkLayer" viewBox="0 0 390 700" preserveAspectRatio="xMidYMid meet">

