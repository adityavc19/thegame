<button class="replay-btn" id="replayBtn">Replay</button>

<script>
  const container = document.getElementById('container');

  function getAllAnimatable() {
    return container.querySelectorAll(
      '.center-node, .center-keyword, .node, .node-t, ' +
      '.prop-line, .sec-line, .ter-line, ' +
      '.sig-diamond, .sig-cross, .sig-square, .sig-bracket, .sig-tick, .sig-dots, .sig-arc, ' +
      '.theme-icon, .theme-icon-ink, .theme-fill, .theme-fill-ink, ' +
      '.micro-glyph'
    );
  }

  function reset() {
    container.classList.remove('contracting');
    getAllAnimatable().forEach(el => el.classList.remove('active'));
  }

  function play() {
    reset();
    void container.offsetHeight;
    requestAnimationFrame(() => {
      getAllAnimatable().forEach(el => el.classList.add('active'));
    });
    setTimeout(() => {
      container.classList.add('contracting');
    }, 1800);
  }

  setTimeout(play, 300);
  document.getElementById('replayBtn').addEventListener('click', play);
</script>
