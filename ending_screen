        <div style={{ fontSize: 20, lineHeight: 1.3, marginBottom: 10 }}>{d.turning.decision}: <span style={{ color: "#C4653A" }}>{d.turning.choice}</span></div>
        <p style={{ fontSize: 14, lineHeight: 1.75, color: "#6A6560", margin: 0, maxWidth: 480 }}>{d.turning.insight}</p>
      </div>

      <div style={{ marginBottom: 40 }}>
        <div style={{ fontSize: 9, letterSpacing: "0.25em", color: "#8A8478", fontFamily: "system-ui, sans-serif", fontWeight: 600, marginBottom: 14, textTransform: "uppercase" }}>Full comparison</div>
        <table style={{ width: "100%", borderCollapse: "collapse" }}>
          <thead>
            <tr style={{ borderBottom: "2px solid #1A1916" }}>
              <th style={{ textAlign: "left", padding: "8px 0", fontSize: 9, letterSpacing: "0.15em", fontFamily: "system-ui, sans-serif", color: "#8A8478", fontWeight: 600 }}></th>
              <th style={{ textAlign: "right", padding: "8px 0", fontSize: 9, letterSpacing: "0.15em", fontFamily: "system-ui, sans-serif", color: "#C4653A", fontWeight: 600 }}>YOU</th>
              <th style={{ textAlign: "right", padding: "8px 0", fontSize: 9, letterSpacing: "0.15em", fontFamily: "system-ui, sans-serif", color: "#8A8478", fontWeight: 600 }}>HISTORY</th>
            </tr>
          </thead>
          <tbody>
            {[["Status", d.player.status, d.history.status], ["Market Share", d.player.share, d.history.share], ["Revenue", d.player.revenue, d.history.revenue], ["Costs", d.player.costs, d.history.costs], ["P&L", d.player.pnl, d.history.pnl]].map(([label, p, h], i) => (
              <tr key={i} style={{ borderBottom: "1px solid #E0DCD4" }}>
                <td style={{ padding: "10px 0", fontSize: 13, color: "#6A6560" }}>{label}</td>
                <td style={{ padding: "10px 0", fontSize: 15, textAlign: "right", color: label === "P&L" ? "#C4653A" : "#1A1916" }}>{p}</td>
                <td style={{ padding: "10px 0", fontSize: 15, textAlign: "right", color: "#BBB5A8" }}>{h}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div style={{ borderLeft: "2px solid #C4653A", paddingLeft: 20, marginBottom: 40 }}>
        <p style={{ fontSize: 14, lineHeight: 1.75, color: "#6A6560", fontStyle: "italic", margin: 0 }}>
          You outperformed reality by $6.5B in losses — but still couldn't crack the app ecosystem. The platform war was unwinnable. You just made it less expensive to lose.
        </p>
      </div>

      <div style={{ marginBottom: 40 }}>
        <div style={{ fontSize: 9, letterSpacing: "0.25em", color: "#8A8478", fontFamily: "system-ui, sans-serif", fontWeight: 600, marginBottom: 14, textTransform: "uppercase" }}>Your decisions</div>
        {d.decisions.map((dec, i) => (
          <div key={i} style={{ display: "flex", alignItems: "flex-start", gap: 12, padding: "11px 0", borderBottom: i < d.decisions.length - 1 ? "1px solid #E8E4DC" : "none" }}>
            <div style={{ background: i === 0 ? "#C4653A" : "#1A1916", color: "#F5F0E8", width: 20, height: 20, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 10, fontFamily: "system-ui, sans-serif", flexShrink: 0, marginTop: 2 }}>{i + 1}</div>
            <div>
              <div style={{ fontSize: 14 }}>{dec.title}</div>
              <div style={{ fontSize: 13, color: "#8A8478" }}>{dec.choice}</div>
            </div>
          </div>
        ))}
      </div>

      <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
        <button style={{ background: "#C4653A", color: "#F5F0E8", border: "none", padding: "15px", fontSize: 11, letterSpacing: "0.2em", fontFamily: "system-ui, sans-serif", fontWeight: 600, cursor: "pointer", width: "100%", textTransform: "uppercase" }}>
          Try a different path →
        </button>
        <button style={{ background: "transparent", color: "#8A8478", border: "1px solid #D8D4CC", padding: "13px", fontSize: 10, letterSpacing: "0.15em", fontFamily: "system-ui, sans-serif", cursor: "pointer", width: "100%", textTransform: "uppercase" }}>
          Help us improve
        </button>
      </div>
    </div>
  );
}


