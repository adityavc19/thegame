// MAIN APP
// Dev switcher to preview all 3 +
// simulated unlock states
// ═══════════════════════════════════════
export default function App() {
  const [pub, setPub] = useState("wired");
  const [unlockedCount, setUnlockedCount] = useState(1);

  const unlockStates = {
    1: { wired: ["WIRED"], tc: ["TechCrunch"], time: ["TIME"] },
    2: { wired: ["WIRED", "TechCrunch"], tc: ["TechCrunch", "WIRED"], time: ["TIME", "WIRED"] },
    3: { wired: ["WIRED", "TechCrunch", "TIME"], tc: ["TechCrunch", "WIRED", "TIME"], time: ["TIME", "WIRED", "TechCrunch"] },
  };

  const currentUnlocked = unlockStates[unlockedCount][pub];

  const covers = {
    wired: { label: "WIRED", c: "#fff", Component: WiredCover, data: ARCHETYPES.wired.coverData },
    tc: { label: "TechCrunch", c: "#00BF63", Component: TechCrunchCover, data: ARCHETYPES.tc.coverData },
    time: { label: "TIME", c: "#E3120B", Component: TimeCover, data: ARCHETYPES.time.coverData },
  };

  const { Component, data } = covers[pub];

  return (
    <div style={{ background: "#111", minHeight: "100vh" }}>
      {/* Dev controls */}
      <div style={{
        position: "sticky", top: 0, zIndex: 100,
        background: "rgba(17,17,17,0.95)", backdropFilter: "blur(12px)",
        borderBottom: "1px solid rgba(255,255,255,0.08)",
        padding: "10px 16px",
        display: "flex", flexDirection: "column", gap: 8
      }}>
        {/* Publication switcher */}
        <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
          <span style={{ fontSize: 9, letterSpacing: "0.2em", color: "#555", fontFamily: "system-ui, sans-serif", marginRight: 4 }}>COVER</span>
          {Object.entries(covers).map(([k, v]) => (
            <button key={k} onClick={() => setPub(k)} style={{
              background: pub === k ? v.c : "transparent",
              color: pub === k ? (k === "tc" ? "#fff" : k === "wired" ? "#000" : "#fff") : "rgba(255,255,255,0.35)",
              border: pub === k ? "none" : "1px solid rgba(255,255,255,0.1)",
              padding: "5px 12px", fontSize: 11, fontWeight: pub === k ? 700 : 400,
              fontFamily: k === "time" ? "'Georgia', serif" : "system-ui, sans-serif",
              cursor: "pointer", transition: "all 0.15s"
            }}>
              {v.label}
            </button>
          ))}
        </div>
        {/* Unlock state simulator */}
        <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
          <span style={{ fontSize: 9, letterSpacing: "0.2em", color: "#555", fontFamily: "system-ui, sans-serif", marginRight: 4 }}>UNLOCKED</span>
          {[1, 2, 3].map(n => (
            <button key={n} onClick={() => setUnlockedCount(n)} style={{
              background: unlockedCount === n ? "#C4653A" : "transparent",
              color: unlockedCount === n ? "#fff" : "rgba(255,255,255,0.35)",
              border: unlockedCount === n ? "none" : "1px solid rgba(255,255,255,0.1)",
              padding: "4px 10px", fontSize: 11,
              fontFamily: "system-ui, sans-serif", cursor: "pointer",
            }}>
              {n}/3
            </button>
          ))}
          <span style={{ fontSize: 10, color: "#555", fontFamily: "system-ui, sans-serif", marginLeft: 4 }}>
            ← simulates replay progression
          </span>
        </div>
      </div>

      {/* Phone frame */}
      <div style={{
        maxWidth: 390, margin: "20px auto",
        borderRadius: 8, overflow: "hidden",
        boxShadow: "0 24px 64px rgba(0,0,0,0.6)",
        border: "1px solid rgba(255,255,255,0.06)"
      }}>
        <Component cover={data} shared={SHARED} unlocked={currentUnlocked} />
      </div>
    </div>
  );
}